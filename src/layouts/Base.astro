---
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import './Base.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'うごき帳';
const {
  title,
  description = 'Web 制作でよく使う部品と動きの見本帳。触って試し、HTML・CSS・JS をそのままコピーできます。',
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}/og.png`, Astro.site);
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline src={`${base}/theme.js`}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="l-skip" href="#main">本文へ移動</a>
    <header class="l-header">
      <div class="l-header__inner">
        <a class="l-header__logo" href={`${base}/`}>{siteName}</a>
        <ThemeToggle />
      </div>
    </header>
    <main class="l-main" id="main">
      <slot />
    </main>
    <footer class="l-footer">
      <p class="l-footer__text">© iiiitiiitiiti</p>
    </footer>
    <Toast />
  </body>
</html>
