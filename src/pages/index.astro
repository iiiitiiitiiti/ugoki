---
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import { categories, groups, pieces } from '../pieces';
import '../styles/pages/index.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <!-- 開くタブを決め終わるまで最初の描画を待つ。詳細ページから戻るときの枠の遷移が、決める前の画面で始まらないようにする -->
  <link slot="head" rel="expect" href="#index-ready" blocking="render" />
  <div class="p-index">
    <div class="p-index__intro">
      <h1 class="p-index__title u-phrase">部品と動きの見本帳</h1>
      <p class="p-index__lead u-phrase">
        枠の中で触って試せます。名前を押すと、HTML・CSS・JS をそのままコピーできます。
      </p>
    </div>
    <div class="p-index__bar">
      <div class="p-index__tabs" role="tablist" aria-label="部品の種類">
        {
          groups.map((group, i) => (
            <button
              class="p-index__tab"
              type="button"
              role="tab"
              id={`tab-${group.id}`}
              aria-controls={`panel-${group.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-group={group.id}
            >
              {group.label}
            </button>
          ))
        }
      </div>
      {
        groups.map((group, i) => (
          <nav class="p-index__toc" aria-label={`${group.label}の分類`} data-group={group.id} hidden={i !== 0}>
            <ul class="p-index__toc-list">
              {categories
                .filter((c) => c.group === group.id)
                .map((category) => (
                  <li class="p-index__toc-item">
                    <a class="p-index__toc-link" href={`#category-${category.id}`}>
                      {category.label}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
      }
    </div>
    {
      groups.map((group, i) => (
        <div
          class="p-index__panel"
          role="tabpanel"
          id={`panel-${group.id}`}
          aria-labelledby={`tab-${group.id}`}
          hidden={i === 0 ? undefined : 'until-found'}
        >
          {categories
            .filter((c) => c.group === group.id)
            .map((category) => (
              <section class="p-index__section" aria-labelledby={`category-${category.id}`}>
                <h2 class="p-index__heading" id={`category-${category.id}`} tabindex="-1">
                  {category.label}
                </h2>
                <div class="p-index__grid">
                  {pieces
                    .filter((p) => p.category === category.id)
                    .map((piece) => (
                      <PieceCard piece={piece} />
                    ))}
                </div>
              </section>
            ))}
        </div>
      ))
    }
    <script is:inline src={`${base}/index-tabs-init.js`}></script>
    <span id="index-ready" hidden></span>
  </div>
</Base>

<script>
  import '../scripts/index-tabs.js';
</script>
