---
import Base from '../../layouts/Base.astro';
import PieceStage from '../../components/PieceStage.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { categoryLabel, pieces } from '../../pieces';
import type { Piece } from '../../pieces/types';
import '../../styles/pages/piece.css';

export function getStaticPaths() {
  return pieces.map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={piece.title} description={piece.summary}>
  <article class="p-piece">
    <a class="p-piece__back" href={`${base}/`}>← 一覧へ戻る</a>
    <div class="p-piece__head">
      <p class="p-piece__category">{categoryLabel(piece.category)}</p>
      <h1 class="p-piece__title">{piece.title}</h1>
      <p class="p-piece__summary">{piece.summary}</p>
    </div>
    <div class="p-piece__stage">
      <PieceStage piece={piece} size="detail" />
    </div>
    <CodeBlock piece={piece} />
  </article>
</Base>
