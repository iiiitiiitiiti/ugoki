---
import Base from '../../layouts/Base.astro';
import PieceStage from '../../components/PieceStage.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { categories, categoryLabel, pieces } from '../../pieces';
import type { Piece } from '../../pieces/types';
import '../../styles/pages/piece.css';

export function getStaticPaths() {
  return pieces.map((piece, i) => ({
    params: { slug: piece.slug },
    props: { piece, prev: pieces[i - 1], next: pieces[i + 1] },
  }));
}

interface Props {
  piece: Piece;
  prev?: Piece;
  next?: Piece;
}

const { piece, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 一覧の、この作のカードへ戻す。動かないパーツならそのタブを開く
const group = categories.find((c) => c.id === piece.category)?.group;
const backHref = `${base}/${group === 'static' ? '?tab=static' : ''}#piece-${piece.slug}`;
---

<Base title={piece.title} description={piece.summary}>
  <article class="p-piece">
    <a class="p-piece__back" href={backHref}>一覧へ戻る</a>
    <div class="p-piece__head">
      <p class="p-piece__category">{categoryLabel(piece.category)}</p>
      <h1 class="p-piece__title u-phrase">{piece.title}</h1>
      <p class="p-piece__summary u-phrase">{piece.summary}</p>
    </div>
    <div class="p-piece__main">
      <div class="p-piece__stage">
        <PieceStage piece={piece} size="detail" />
      </div>
      <div class="p-piece__code">
        <CodeBlock piece={piece} />
      </div>
    </div>
    <nav class="p-piece__pager" aria-label="前後の部品">
      {
        prev && (
          <a class="p-piece__pager-link p-piece__pager-link--prev" href={`${base}/pieces/${prev.slug}/`}>
            <span class="p-piece__pager-label">前へ</span>
            <span class="p-piece__pager-title u-phrase">{prev.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="p-piece__pager-link p-piece__pager-link--next" href={`${base}/pieces/${next.slug}/`}>
            <span class="p-piece__pager-label">次へ</span>
            <span class="p-piece__pager-title u-phrase">{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
